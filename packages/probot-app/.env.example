# The ID of your GitHub App
APP_ID=
WEBHOOK_SECRET=development

# Uncomment and set the path to your GitHub App private key file
# PRIVATE_KEY_PATH=./private-key.pem

# Use `trace` to get verbose logging or `info` to show less
LOG_LEVEL=debug

# Go to https://smee.io/new and set this to the URL you are redirected to.
# This proxies GitHub webhook events to your local machine during development.
WEBHOOK_PROXY_URL=
