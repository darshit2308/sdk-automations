{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiero-hackers.github.io/sdk-automations/schemas/hiero-automation.schema.json",
  "title": "Hiero SDK Automation Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maintainerTeam": { "type": "string", "minLength": 1 },
    "goodFirstIssueSupportTeam": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "required": ["owner", "name"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "labels": {
      "type": "object",
      "required": ["reviewQueue"],
      "additionalProperties": false,
      "properties": {
        "reviewQueue": {
          "type": "object",
          "required": [
            "juniorCommitter",
            "committers",
            "maintainers",
            "readyToMerge",
            "communityReview"
          ],
          "additionalProperties": false,
          "properties": {
            "juniorCommitter": { "type": "string", "minLength": 1 },
            "committers": { "type": "string", "minLength": 1 },
            "maintainers": { "type": "string", "minLength": 1 },
            "readyToMerge": { "type": "string", "minLength": 1 },
            "communityReview": { "type": "string", "minLength": 1 }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "skill": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "priority": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewSync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "rateLimitFloor": { "type": "integer", "minimum": 0 },
        "includeDraftPullRequests": { "type": "boolean" },
        "dryRunDefault": { "type": "boolean" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxOpenAssignments": { "type": "integer", "minimum": 0 },
        "maxGoodFirstIssueCompletions": { "type": "integer", "minimum": 0 }
      }
    },
    "assignmentLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOpenAssignments": { "type": "integer", "minimum": 0 },
        "maxGfiCompletions": { "type": "integer", "minimum": 0 }
      }
    },
    "skillHierarchy": {
      "type": "array",
      "items": { "type": "string" }
    },
    "priorityHierarchy": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skillPrerequisites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["requiredLabel", "requiredCount", "displayName"],
        "additionalProperties": false,
        "properties": {
          "requiredLabel": { "type": ["string", "null"] },
          "requiredCount": { "type": "integer", "minimum": 0 },
          "displayName": { "type": "string", "minLength": 1 },
          "prerequisiteDisplayName": { "type": "string", "minLength": 1 }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "community": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "required": ["repository", "labels"]
}
